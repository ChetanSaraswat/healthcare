APP_PORT=8080
APP_FORWARD_PORT=8080
NODE_ENV=development
CLIENT_URL=http://localhost:3000,http://localhost:3001

# Database Configuration
# In Docker network (aarogyamed-shared-network): DB_HOST=database, DB_PORT=5432
# If running directly on host machine without Docker: DB_HOST=localhost, DB_PORT=5434
DB_HOST=database
DB_PORT=5432
DB_FORWARD_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=aarogyamed_db
DB_TEST_DATABASE=aarogyamed_test_db
DB_SSL=true
DB_POOL_MAX=5 
DB_POOL_MIN=0

# JWT & Authentication
JWT_SECRET=aarogyamed_super_secret_jwt_key_2026
JWT_EXPIRATION=7d

# Email / SMTP Configuration
# In Docker network: connects to Mailpit (host: mailpit, port: 1025)
# Web UI accessible on host browser at http://localhost:8026
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Omkar Healthcare <care@omkarhealthcare.com>

# Payment Gateway (Razorpay Mock / Sandbox)
RAZORPAY_KEY_ID=rzp_test_aarogya_med_2026
RAZORPAY_KEY_SECRET=secret_test_aarogya_med_key_2026
RAZORPAY_WEBHOOK_SECRET=webhook_secret_aarogya_med_2026

# Cloudflare Public Tunnel for Razorpay Webhooks (Local Testing)
CLOUDFLARE_TUNNEL_URL=https://your-tunnel-subdomain.trycloudflare.com
RAZORPAY_WEBHOOK_URL=https://your-tunnel-subdomain.trycloudflare.com/api/v1/payments/razorpay/webhook

# Admin / Owner Transaction Notifications (WhatsApp & Email Alerts)
ADMIN_NOTIFICATION_EMAIL=care@omkarhealthcare.com
# Recipient of admin order and rental WhatsApp alerts (separate from public business contact number)
ADMIN_ALERT_PHONE=+91XXXXXXXXXX
ADMIN_WHATSAPP_NUMBER=+91XXXXXXXXXX
# WHATSAPP_PROVIDER options: 'mock' (default for dev/test), 'cloud_api' (Meta), or 'twilio'
WHATSAPP_PROVIDER=mock

# Meta WhatsApp Cloud API (if WHATSAPP_PROVIDER=cloud_api)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0

# Twilio WhatsApp API (if WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

PGADMIN_FORWARD_PORT=8888
PGADMIN_DEFAULT_EMAIL=admin@omkarhealthcare.com
PGADMIN_DEFAULT_PASSWORD=admin

# Cloudinary Persistent Media Storage (Ephemeral/Multi-Instance Deployment)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=products

