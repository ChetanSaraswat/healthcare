{
  "name": "aarogyamed-backend",
  "version": "1.0.0",
  "description": "AarogyaMed Medical Equipment Buy & Rent Platform - Backend REST API",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "echo 'Backend build check passed' && node -c index.js",
    "dev": "nodemon index.js",
    "up": "npx sequelize-cli db:migrate",
    "undo": "npx sequelize-cli db:migrate:undo",
    "undo:all": "npx sequelize-cli db:migrate:undo:all",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:all": "npx sequelize-cli db:seed:all",
    "seed:products": "node scripts/seed-mock-products.js",
    "seed:undo": "npx sequelize-cli db:seed:undo",
    "test": "node tests/payment-authority.test.js && node tests/api.integration.test.js && node tests/cloudinary-storage.test.js",
    "test:payments": "node tests/payment-authority.test.js",
    "test:api": "node tests/api.integration.test.js",
    "test:storage": "node tests/cloudinary-storage.test.js",
    "migrate:uploads": "node scripts/migrate-uploads-to-cloudinary.js",
    "tunnel": "node scripts/start-tunnel.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "razorpay": "^2.9.8",
    "sequelize": "^6.37.5",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2"
  }
}
