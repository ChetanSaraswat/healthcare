PORT=3001
APP_FORWARD_PORT=3001

# Dual Backend URLs
# 1. Server-side (SSR / Server Components inside Docker network):
NEXT_PUBLIC_BACKEND_URL=http://aarogyamed-backend:8080

# 2. Client-side (Browser / Client Components / Thunks on host machine):
NEXT_PUBLIC_CLIENT_URL=http://localhost:8080

# Link to Public Storefront
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
