{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@aarogyamed/types": ["./src/types/index.ts"],
      "@aarogyamed/types/*": ["./src/types/*"],
      "@aarogyamed/i18n": ["./src/locales/index.ts"],
      "@aarogyamed/i18n/*": ["./src/locales/*"],
      "@aarogyamed/styles/*": ["./src/styles/*"],
      "@/domain/*": ["./src/types/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
